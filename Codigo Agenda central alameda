    <script>
    function filtrarServicios() {
        let input = document.getElementById('inputBusqueda').value.toLowerCase();
        let filas = document.getElementsByClassName('fila');
        let separadores = document.getElementsByClassName('dia-separador');
        for (let i = 0; i < filas.length; i++) {
            let vehiculo = filas[i].querySelector('.txt-vehiculo').innerText.toLowerCase();
            let patente = filas[i].querySelector('.txt-patente').innerText.toLowerCase();
            let cliente = filas[i].querySelector('.txt-cliente').innerText.toLowerCase();
            if (vehiculo.includes(input) || patente.includes(input) || cliente.includes(input)) {
                filas[i].style.display = "";
            } else {
                filas[i].style.display = "none";
            }
        }
        for (let j = 0; j < separadores.length; j++) {
            let tieneVisibles = false;
            let hermanos = separadores[j].nextElementSibling;
            while(hermanos && !hermanos.classList.contains('dia-separador')) {
                if(hermanos.classList.contains('fila') && hermanos.style.display === "") {
                    tieneVisibles = true;
                    break;
                }
                hermanos = hermanos.nextElementSibling;
            }
            separadores[j].style.display = tieneVisibles || input === "" ? "" : "none";
        }
    }

    function fastUpdate(id, campo, valor) {
        if(valor === "") return;
        const formData = new FormData();
        formData.append('ajax_update', '1'); formData.append('id', id); formData.append('campo', campo); formData.append('valor', valor);
        fetch('index.php', { method: 'POST', body: formData })
        .then(() => {
            if(campo === 'llego_al_taller') { document.querySelector('#fila-'+id+' select').className = 'est-'+valor; }
            if(campo === 'estado_pago') {
                const t=['⏳ Pendiente','💳 Pagado','❌ No Paga'];
                document.getElementById('pago-box-'+id).innerHTML = `<span class="pago-${valor}">${t[valor]}</span>`;
            }
        });
    }

    function borrarFila(id) {
        if (confirm("¿Borrar este registro?")) {
            window.location.href = "index.php?del=" + id;
        }
    }

    function confirmarVaciar() {
        const pass = prompt("⚠️ Ingrese clave para VACIAR TODA LA WEB:");
        if (pass === "AdminAlameda2026") {
            if (confirm("¿Estás 100% segura? Se borrará todo.")) {
                window.location.href = "index.php?vaciar_todo=1";
            }
        } else if (pass !== null) { alert("❌ Clave incorrecta."); }
    }

    setInterval(() => {
        if (document.getElementById('inputBusqueda').value !== "" ||
            document.activeElement.tagName === 'INPUT' ||
            document.activeElement.tagName === 'TEXTAREA') return;
        fetch(window.location.href).then(r => r.text()).then(h => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(h, 'text/html');
            const target = document.getElementById('servicios_contenedor');
            const source = doc.getElementById('servicios_contenedor');
            if (target && source) { target.innerHTML = source.innerHTML; }
        });
    }, 15000);
    </script>
